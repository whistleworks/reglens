{
 "title": "RegLens",
 "uid": "reglens",
 "schemaVersion": 39,
 "version": 1,
 "timezone": "utc",
 "refresh": "1m",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "datasource",
    "type": "datasource",
    "query": "prometheus"
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Requests per second by route",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (route) (rate(reglens_requests_total[5m]))",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Error rate by type",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (type) (rate(reglens_errors_total[5m])) / ignoring(type) group_left sum(rate(reglens_requests_total[5m]))",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "End-to-end latency p50 / p95 / p99",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le) (rate(reglens_latency_seconds_bucket{stage=\"http\",route=\"/v1/ask\"}[5m])))",
     "legendFormat": ""
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(reglens_latency_seconds_bucket{stage=\"http\",route=\"/v1/ask\"}[5m])))",
     "legendFormat": ""
    },
    {
     "refId": "C",
     "expr": "histogram_quantile(0.99, sum by (le) (rate(reglens_latency_seconds_bucket{stage=\"http\",route=\"/v1/ask\"}[5m])))",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Cost per query (shadow USD)",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rate(reglens_cost_usd_total[1h]) / sum(rate(reglens_requests_total{route=~\"/v1/ask|/ui/ask\"}[1h]))",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Daily shadow cost vs budget",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 16
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "increase(reglens_cost_usd_total[24h])",
     "legendFormat": ""
    },
    {
     "refId": "B",
     "expr": "reglens_budget_remaining_usd",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Tokens by direction",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 16
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (direction) (rate(reglens_tokens_total[5m]))",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 7,
   "type": "bargauge",
   "title": "Agent steps distribution",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 24
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (le) (increase(reglens_agent_steps_bucket[1h]))",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Refusals and citation failures",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 24
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (reason) (rate(reglens_refusals_total[15m]))",
     "legendFormat": ""
    },
    {
     "refId": "B",
     "expr": "rate(reglens_citation_failures_total[15m])",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Degraded mode (sources only) by cause",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 32
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (mode) (rate(reglens_degraded_total[15m]))",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Provider 429 and LLM errors",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 32
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rate(reglens_provider_429_total[15m])",
     "legendFormat": ""
    },
    {
     "refId": "B",
     "expr": "rate(reglens_errors_total{type=\"llm_unavailable\"}[15m])",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "Retrieval top score (drift)",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 40
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le) (rate(reglens_retrieval_top_score_bucket[1h])))",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 12,
   "type": "piechart",
   "title": "User feedback (up / down)",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 40
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (vote) (increase(reglens_feedback_total[24h]))",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 13,
   "type": "timeseries",
   "title": "Tool errors",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 48
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rate(reglens_tool_errors_total[15m])",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 14,
   "type": "timeseries",
   "title": "Nightly eval trend (recall@5, faithfulness)",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 48
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "reglens_eval_metric{metric=\"recall@5\"}",
     "legendFormat": ""
    },
    {
     "refId": "B",
     "expr": "reglens_eval_metric{metric=\"faithfulness\"}",
     "legendFormat": ""
    }
   ]
  }
 ],
 "tags": [
  "reglens",
  "rag",
  "llm"
 ]
}
