# RegLens configuration. Copy to .env and fill in. All values below are fake placeholders.
# Variables are read only by src/reglens/config.py.

APP_ENV=dev                      # dev | ci | prod
LOG_LEVEL=INFO
GIT_SHA=unknown

# --- API (M4) ---
API_KEYS=change-me-1,change-me-2
CORS_ORIGINS=http://localhost:8000
RATE_LIMIT_PER_MIN=30
MAX_INPUT_CHARS=2000
DAILY_BUDGET_USD=1.0

# --- LLM (M3) ---
LLM_PRIMARY_MODEL=groq/openai/gpt-oss-120b
LLM_FALLBACK_MODELS=gemini/gemini-2.5-flash
LLM_TIMEOUT_S=20
JUDGE_MODEL=gemini/gemini-2.5-flash
GROQ_API_KEY=gsk_fake
GEMINI_API_KEY=fake

# --- Retrieval ---
EMBEDDING_MODEL=intfloat/multilingual-e5-large
SPARSE_MODEL=Qdrant/bm25
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANK_ENABLED=false
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=
INDEX_MODE=cloud                 # cloud | local_snapshot

# --- Observability (M4) ---
LANGFUSE_PUBLIC_KEY=pk-lf-fake
LANGFUSE_SECRET_KEY=sk-lf-fake
LANGFUSE_HOST=https://cloud.langfuse.com
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
